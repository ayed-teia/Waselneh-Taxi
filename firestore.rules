rules_version = '2';

/**
 * Taxi Line Platform - Firestore Security Rules
 * 
 * Architecture principles:
 * - All business logic lives in Cloud Functions
 * - Clients have minimal write access
 * - Most writes go through callable functions
 * - Clients can read their own data in realtime
 */
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // Helper Functions
    // =========================================================================
    
    /**
     * Check if the request is authenticated
     */
    function isAuthenticated() {
      return request.auth != null;
    }
    
    /**
     * Check if the authenticated user matches the given uid
     */
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    /**
     * Check if the user has a specific role (stored in custom claims)
     */
    function hasRole(role) {
      return isAuthenticated() &&
        ('role' in request.auth.token) &&
        request.auth.token.role == role;
    }

    function managerRoleDocPath(uid) {
      return /databases/$(database)/documents/managerRoles/$(uid);
    }

    /**
     * Privilege-granting fields on users/{uid}. SECURITY (R1): these must never be
     * written by the document owner - see match /users/{uid}. Cloud Functions use the
     * Admin SDK, which bypasses these rules, so backend provisioning is unaffected.
     */
    function privilegeFields() {
      return [
        'role',
        'permissions',
        'officeIds',
        'officeId',
        'lineIds',
        'lineId',
        'managerRole',
        'status',
      ];
    }

    /** True if an incoming document carries any privilege field at all. */
    function writesPrivilegeFields() {
      return request.resource.data.keys().hasAny(privilegeFields());
    }

    /**
     * True if this update adds, removes, or modifies any privilege field.
     * An update that leaves them byte-identical is allowed, so a client can safely
     * re-send a document it just read.
     */
    function changesPrivilegeFields() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(privilegeFields());
    }

    function isManagerRoleValue(value) {
      return value == 'admin' ||
        value == 'manager' ||
        value == 'operations_manager' ||
        value == 'dispatcher' ||
        value == 'support';
    }

    function hasManagerClaim() {
      return isAuthenticated() &&
        (
          hasRole('manager') ||
          hasRole('admin') ||
          (
            ('managerRole' in request.auth.token) &&
            isManagerRoleValue(request.auth.token.managerRole)
          )
        );
    }
    
    /**
     * Check if user is a manager.
     *
     * SECURITY (R1): manager status comes ONLY from a verified custom claim, or from an
     * ACTIVE managerRoles/{uid} document. This previously also trusted users/{uid}.role.
     * Because users can write their own users/{uid} document, any authenticated user
     * could self-assign role: "admin", become a manager, and then write managerRoles/*
     * to make the escalation permanent. That branch is removed.
     */
    function isManager() {
      return hasManagerClaim() ||
        (
          isAuthenticated() &&
          exists(managerRoleDocPath(request.auth.uid)) &&
          isManagerRoleValue(get(managerRoleDocPath(request.auth.uid)).data.role) &&
          get(managerRoleDocPath(request.auth.uid)).data.isActive == true
        );
    }
    
    /**
     * Check if user is a driver
     */
    function isDriver() {
      return hasRole('driver') ||
        (
          isAuthenticated() &&
          driverDocExists(request.auth.uid)
        );
    }
    
    /**
     * Driver profile path helper
     */
    function driverDocPath(uid) {
      return /databases/$(database)/documents/drivers/$(uid);
    }

    function driverDoc(uid) {
      return get(driverDocPath(uid));
    }

    function driverDocExists(uid) {
      return exists(driverDocPath(uid));
    }

    function tripDocPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    function isTripParticipantById(tripId) {
      return isAuthenticated() &&
        exists(tripDocPath(tripId)) &&
        (
        get(tripDocPath(tripId)).data.passengerId == request.auth.uid ||
        get(tripDocPath(tripId)).data.driverId == request.auth.uid
        );
    }

    /**
     * True if the caller is the passenger on the trip this driver is currently
     * assigned to.
     *
     * SECURITY (PII): drivers/{driverId} and driverLive/{driverId} used to be readable
     * by ANY authenticated user, which let anyone enumerate every driver's nationalId,
     * phone number and live GPS position. Reads are now scoped to the people who
     * actually need them: the driver themselves, a manager, and the passenger of record
     * on the driver's current trip.
     *
     * The link is drivers/{driverId}.currentTripId -> trips/{tripId}.passengerId, so a
     * passenger can only reach the driver who is actually assigned to them, and only
     * while that assignment stands.
     */
    function isPassengerOfDriverCurrentTrip(driverId) {
      return isAuthenticated() &&
        exists(driverDocPath(driverId)) &&
        driverDoc(driverId).data.currentTripId is string &&
        driverDoc(driverId).data.currentTripId.size() > 0 &&
        exists(tripDocPath(driverDoc(driverId).data.currentTripId)) &&
        get(tripDocPath(driverDoc(driverId).data.currentTripId)).data.passengerId
          == request.auth.uid;
    }

    function hasValidLineOrLicenseLink(data) {
      return (
        (data.lineId is string && data.lineId.size() > 0) ||
        (data.licenseId is string && data.licenseId.size() > 0)
      );
    }

    function isLicensedLineOwnerData(data) {
      return (
        data.driverType == 'licensed_line_owner' &&
        data.verificationStatus == 'approved' &&
        hasValidLineOrLicenseLink(data)
      );
    }

    function isLicensedLineOwner(uid) {
      return isOwner(uid) && driverDocExists(uid) && isLicensedLineOwnerData(driverDoc(uid).data);
    }

    function preservesDriverEligibilityFields() {
      return (
        (!('driverType' in request.resource.data) ||
          request.resource.data.driverType == resource.data.driverType) &&
        (!('verificationStatus' in request.resource.data) ||
          request.resource.data.verificationStatus == resource.data.verificationStatus) &&
        (!('lineId' in request.resource.data) ||
          request.resource.data.lineId == resource.data.lineId) &&
        (!('licenseId' in request.resource.data) ||
          request.resource.data.licenseId == resource.data.licenseId) &&
        (!('vehicleType' in request.resource.data) ||
          request.resource.data.vehicleType == resource.data.vehicleType) &&
        (!('seatCapacity' in request.resource.data) ||
          request.resource.data.seatCapacity == resource.data.seatCapacity)
      );
    }
    
    // =========================================================================
    // Default: Deny all access (PRODUCTION)
    // For development/emulator, allow all access
    // =========================================================================
    
    match /{document=**} {
      allow read, write: if false;
    }
    
    // =========================================================================
    // Users Collection
    // Path: /users/{uid}
    // 
    // User profile documents containing passenger, driver, or manager data.
    // - Users can read and write their own profile
    // - Managers can read and write all profiles (for admin purposes)
    // - No cross-user access for regular users
    // =========================================================================
    match /users/{uid} {
      // User can read their own document, managers can read any
      allow read: if isOwner(uid) || isManager();

      // SECURITY (R1): an owner may maintain their own profile (displayName, photo,
      // locale, ...) but must never set or change a privilege field on it. Only a
      // manager may do that from a client; backend provisioning goes through Cloud
      // Functions on the Admin SDK, which bypasses these rules entirely.
      // Note: user creation is normally handled by a Cloud Function auth trigger.
      allow create: if isManager() ||
        (isOwner(uid) && !writesPrivilegeFields());
      allow update: if isManager() ||
        (isOwner(uid) && !changesPrivilegeFields());
      allow delete: if isManager();
    }

    // =========================================================================
    // Manager Roles Collection (RBAC source of truth)
    // Path: /managerRoles/{uid}
    // =========================================================================
    match /managerRoles/{uid} {
      allow read: if isOwner(uid) || isManager();
      allow write: if isManager();
    }

    // =========================================================================
    // User Devices Collection (Push Tokens / Installations)
    // Path: /userDevices/{uid}
    // =========================================================================
    match /userDevices/{uid} {
      allow read: if isOwner(uid) || isManager();
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid) || isManager();
    }

    // =========================================================================
    // User Notifications Collection
    // Path: /userNotifications/{uid}/items/{notificationId}
    // =========================================================================
    match /userNotifications/{uid} {
      allow read: if isOwner(uid) || isManager();
      allow write: if false;

      match /items/{notificationId} {
        allow read: if isOwner(uid) || isManager();

        // Users can only mark an existing notification as read.
        allow update: if isOwner(uid) &&
          request.resource.data.read == true &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['read', 'readAt']);

        allow create, delete: if false;
      }
    }
    
    // =========================================================================
    // Driver Live Location Collection
    // Path: /driverLive/{driverId}
    // 
    // Real-time driver location data, isolated from trip documents for
    // performance and security.
    // - Drivers can only write their own location
    // - Location reads are restricted to prevent tracking
    // - Passengers can read location only for their active trip's driver
    // - Managers can read all for monitoring
    // 
    // Passenger reads are scoped via drivers/{driverId}.currentTripId -> the trip's
    // passengerId, so a passenger can only read the location of the driver actually
    // assigned to them. See isPassengerOfDriverCurrentTrip().
    // =========================================================================
    match /driverLive/{driverId} {
      // Driver can create/update live location only when fully eligible
      allow create, update: if isLicensedLineOwner(driverId);

      // Allow owner delete for safe cleanup when going offline
      allow delete: if isOwner(driverId);
      
      // Reading driver location:
      // - Managers can read all, including listing the collection (monitoring dashboard)
      // - Drivers can read their own location
      // - The passenger on this driver's current trip can read it, for the live trip UI
      //
      // SECURITY (PII): this previously ended in "|| isAuthenticated()", so any signed-in
      // account could stream ANY driver's live GPS position. That blanket clause is gone.
      allow read: if isOwner(driverId) ||
        isManager() ||
        isPassengerOfDriverCurrentTrip(driverId);
    }
    
    // =========================================================================
    // Drivers Collection with Inbox Subcollection
    // Path: /drivers/{driverId}
    // Path: /drivers/{driverId}/inbox/{requestId}
    // 
    // Driver availability and profile data:
    // - isOnline: boolean - Driver has toggled to online
    // - isAvailable: boolean - Driver can receive new trips (set by Cloud Functions)
    // - lastLocation: GeoPoint - Last known location
    // - currentTripId: string | null - Current trip if on one
    // - updatedAt: Timestamp
    // 
    // WRITE RULES:
    // - Driver can set isOnline and lastLocation (going online/offline)
    // - Cloud Functions set isAvailable (accept trip = false, complete = true)
    // - Cloud Functions use Admin SDK which bypasses security rules
    // =========================================================================
    match /drivers/{driverId} {
      // SECURITY (PII): this was "allow read: if isAuthenticated()", so any signed-in
      // account could read - and list - every driver document, including nationalId and
      // phone. Reads are now scoped to the driver themselves, managers, and the
      // passenger of record on the driver's current trip (who needs the driver card
      // during and just after a trip).
      //
      // KNOWN LIMIT: Firestore read rules are per-DOCUMENT, not per-field. The
      // passenger of record therefore still receives the whole driver document,
      // nationalId and phone included. Removing that requires moving PII into a
      // private subcollection (a data-model change) - see HARDENING_REPORT.md.
      allow read: if isOwner(driverId) ||
        isManager() ||
        isPassengerOfDriverCurrentTrip(driverId);
      
      // Managers can manage driver profiles (including verification fields).
      // Driver clients can update status/location fields only if they are eligible,
      // and cannot mutate eligibility fields directly.
      // Non-eligible drivers are allowed to write only when forcing themselves offline.
      allow create: if isManager();
      allow update: if isManager() || (
        isOwner(driverId) &&
        preservesDriverEligibilityFields() &&
        (isLicensedLineOwner(driverId) || request.resource.data.isOnline == false)
      );
      allow delete: if isManager();
      
      // =====================================================================
      // PRIVATE PII SUBCOLLECTION
      // Path: /drivers/{driverId}/private/{docId}   (the doc is 'pii')
      //
      // SECURITY: nationalId, phone and the driver's legal fullName live HERE and
      // never on the parent drivers/{driverId} document. Firestore read rules are
      // per-document, so the passenger on an active trip - who legitimately reads the
      // parent doc for the driver card - would otherwise receive the PII with it.
      // Only the driver themselves and managers can read this subcollection.
      //
      // Writes are Cloud-Functions-only (Admin SDK bypasses rules), so no client can
      // forge or alter identity fields.
      // =====================================================================
      match /private/{docId} {
        allow read: if isOwner(driverId) || isManager();
        allow write: if false;
      }

      // Onboarding document metadata:
      // drivers/{driverId}/private/documents/items/{documentType}
      //
      // Same read scope as the PII doc above - the driver and managers only, never
      // a passenger. Writes are Cloud-Functions-only because the status field is an
      // AUTHORIZATION decision: a driver who could write it would approve their own
      // licence. The file itself lives in Storage under storage.rules.
      match /private/documents/items/{documentType} {
        allow read: if isOwner(driverId) || isManager();
        allow write: if false;
      }

      // Inbox subcollection
      match /inbox/{requestId} {
        // Driver can read their own inbox items
        allow read: if isOwner(driverId) || isManager();
        
        // NO direct writes - inbox is managed by Cloud Functions
        // Cloud Functions use Admin SDK which bypasses security rules
        allow write: if false;
      }
    }
    
    // =========================================================================
    // Driver Requests Collection (Trip Request Notifications)
    // Path: /driverRequests/{driverId}/requests/{tripId}
    // 
    // Real-time trip request notifications sent to drivers by Cloud Functions.
    // - Cloud Functions create requests (Admin SDK bypasses rules)
    // - Drivers can read their own requests
    // - Drivers can update status to accept/reject
    // =========================================================================
    match /driverRequests/{driverId} {
      // Driver can read the parent document
      allow read: if isOwner(driverId) || isManager();
      
      // Requests subcollection
      match /requests/{tripId} {
        // Driver can read their own pending requests
        allow read: if isOwner(driverId) || isManager();
        
        // Driver can update status (accept/reject)
        allow update: if isOwner(driverId) &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['accepted', 'rejected'] &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'status',
            'acceptedAt',
            'rejectedAt'
          ]);
        
        // NO direct creates or deletes - managed by Cloud Functions
        allow create, delete: if false;
      }
    }
    
    // =========================================================================
    // Trips Collection
    // Path: /trips/{tripId}
    // 
    // Trip documents containing full trip lifecycle data.
    // - Passengers can read their own trips (passengerId == uid)
    // - Drivers can read trips assigned to them (driverId == uid)
    // - Managers can read all trips for support and reporting
    // - NO direct client writes - all modifications through Cloud Functions
    // - This ensures trip state machine integrity and proper fare calculation
    // =========================================================================
    match /trips/{tripId} {
      // Passengers can read trips where they are the passenger
      // Drivers can read trips where they are assigned
      // Managers can read all trips
      allow read: if (
        isAuthenticated() && (
          resource.data.passengerId == request.auth.uid ||
          resource.data.driverId == request.auth.uid
        )
      ) || isManager();
      
      // NO direct writes allowed - all trip operations go through Cloud Functions
      // Protected fields: status transitions, fare, timestamps, driver assignment
      // Cloud Functions use Admin SDK which bypasses these rules
      allow write: if false;

      // Chat messages between trip participants
      match /messages/{messageId} {
        allow read: if isTripParticipantById(tripId) || isManager();
        allow create: if isTripParticipantById(tripId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.senderRole in ['passenger', 'driver'] &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // Payments Collection
    // Path: /payments/{paymentId}
    //
    // Payment records derived from completed trips.
    // - Managers can read all payments for reporting/operations
    // - Trip participants can read their own payment records
    // - NO direct client writes (Cloud Functions are source of truth)
    // =========================================================================
    match /payments/{paymentId} {
      allow read: if isManager() || (
        isAuthenticated() && (
          resource.data.passengerId == request.auth.uid ||
          resource.data.driverId == request.auth.uid
        )
      );
      allow write: if false;
    }
    
    // =========================================================================
    // Trip Requests Collection
    // Path: /tripRequests/{requestId}
    // 
    // Pending trip requests before driver assignment.
    // - Used for driver matching queue
    // - NO direct client writes - requests created via Cloud Functions
    // - Drivers can read available requests in their area
    // =========================================================================
    match /tripRequests/{requestId} {
      // Drivers can read available requests for matching
      // Passengers can read their own requests
      // Managers can read all
      allow read: if isDriver() || 
                    (isAuthenticated() && resource.data.passengerId == request.auth.uid) ||
                    isManager();
      
      // NO direct writes - trip requests are managed by Cloud Functions
      // This ensures proper validation, pricing, and matching logic
      allow write: if false;
    }
    
    // =========================================================================
    // Routes Collection
    // Path: /routes/{routeId}
    // 
    // Predefined taxi line routes (e.g., Nablus-Ramallah, Ramallah-Jenin).
    // - Manager only for read/write
    // - Routes define stops, typical duration, and base pricing
    // =========================================================================
    match /routes/{routeId} {
      // Only managers can read and write route configuration
      allow read, write: if isManager();
    }
    
    // =========================================================================
    // Pricing Rules Collection
    // Path: /pricingRules/{ruleId}
    // 
    // Dynamic pricing configuration including base fares, per-km rates,
    // surge multipliers, and time-based adjustments.
    // - Manager only access to prevent fare manipulation
    // =========================================================================
    match /pricingRules/{ruleId} {
      // Only managers can read and write pricing rules
      allow read, write: if isManager();
    }

    // =========================================================================
    // System Configuration
    // Path: /system/{docId}
    // =========================================================================
    match /system/{docId} {
      allow read: if isManager();
      allow write: if false;
    }

    // =========================================================================
    // Operations Core Collections
    // =========================================================================
    match /cities/{cityId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /offices/{officeId} {
      allow read: if isManager();
      allow write: if false;
    }

    match /lines/{lineId} {
      allow read: if isManager() || isAuthenticated();
      allow write: if false;

      // TAXI-LINE QUEUE: lines/{lineId}/queue/{driverId}
      //
      // Readable by any authenticated user so a driver can see their place in the
      // line and how many are ahead of them - a queue nobody can see is not a queue.
      //
      // WRITES ARE CLOUD-FUNCTIONS-ONLY. Position determines who earns the next
      // fare, so a driver who could write their own position would simply set it to
      // zero. That is the first thing anyone would try, and it is why joinLineQueue
      // assigns position server-side and this rule denies every client write.
      match /queue/{driverId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // Live departures are visible to authenticated users so passenger and driver
    // apps can subscribe in real time. Manifests contain passenger identity and
    // are restricted to that passenger, the assigned driver, or a manager.
    match /routeRuns/{runId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /bookings/{bookingId} {
        allow read: if isManager() ||
          (isAuthenticated() && resource.data.passengerId == request.auth.uid) ||
          (isAuthenticated() &&
            get(/databases/$(database)/documents/routeRuns/$(runId)).data.driverId == request.auth.uid);
        allow write: if false;
      }
    }

    match /licenses/{licenseId} {
      allow read: if isManager();
      allow write: if false;
    }

    match /vehicles/{vehicleId} {
      allow read: if isManager();
      allow write: if false;
    }

    match /pricingProfiles/{profileId} {
      allow read: if isManager();
      allow write: if false;
    }

    match /pricingZones/{zoneId} {
      allow read: if isManager();
      allow write: if false;
    }

    // =========================================================================
    // Monitoring Collections
    // =========================================================================
    match /opsErrors/{errorId} {
      allow read: if isManager();
      allow create: if isAuthenticated() &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 800 &&
        request.resource.data.severity in ['info', 'warning', 'error', 'fatal'];
      allow update, delete: if false;
    }

    match /opsMetrics/{metricId} {
      allow read: if isManager();
      allow write: if false;
    }

    match /opsAlerts/{alertId} {
      allow read: if isManager();
      allow update: if isManager() &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'acknowledgedAt',
          'acknowledgedBy',
          'acknowledgedNote',
          'updatedAt'
        ]);
      allow create, delete: if false;
    }
    
    // =========================================================================
    // Ratings Collection
    // Path: /ratings/{tripId}
    // 
    // Trip ratings submitted by passengers after trip completion.
    // - Ratings are created via Cloud Functions (submitRating) for validation
    // - Passengers can read ratings they submitted
    // - Drivers can read ratings for trips where they were the driver
    // - Managers can read all ratings for analytics
    // - NO direct client writes - Cloud Functions handle validation:
    //   * Passenger owns the trip
    //   * Trip status is 'completed'
    //   * No duplicate ratings
    // =========================================================================
    match /ratings/{tripId} {
      // Passengers can read their own ratings
      // Drivers can read ratings for their trips
      // Managers can read all
      allow read: if isManager() || (
        isAuthenticated() && (
          resource.data.passengerId == request.auth.uid ||
          resource.data.driverId == request.auth.uid
        )
      );
      
      // NO direct writes - ratings are created via submitRating Cloud Function
      // Cloud Functions use Admin SDK which bypasses these rules
      // This ensures:
      // - Only passengers can rate their own completed trips
      // - Trip must be in 'completed' status
      // - No duplicate ratings per trip
      // - Trip status is updated to 'rated' atomically
      allow write: if false;
    }
    
    // =========================================================================
    // Driver Availability Collection (Optional - for matching optimization)
    // Path: /driverAvailability/{driverId}
    // 
    // Tracks which drivers are online and available for trips.
    // - Drivers can update their own availability
    // - Managers can read/write all for system management
    // =========================================================================
    match /driverAvailability/{driverId} {
      allow read: if isOwner(driverId) || isManager();
      allow write: if isOwner(driverId) && isDriver();
    }
    
    // =========================================================================
    // FCM Tokens Collection
    // Path: /fcmTokens/{uid}
    // 
    // Push notification tokens for each user.
    // - Users can only write their own tokens
    // - Cloud Functions read tokens to send notifications
    // =========================================================================
    match /fcmTokens/{uid} {
      allow read: if isOwner(uid) || isManager();
      allow write: if isOwner(uid);
    }
    
    // =========================================================================
    // Roadblocks Collection
    // Path: /roadblocks/{roadblockId}
    // 
    // Road closure and congestion information managed by managers.
    // - Managers mutate roadblocks through permission-checked Cloud Functions
    // - Drivers and passengers can read only (for route planning/awareness)
    // 
    // Fields:
    // - name: string (required)
    // - area: string (optional)
    // - lat: number
    // - lng: number
    // - radiusMeters: number
    // - status: 'open' | 'closed' | 'congested'
    // - note: string (optional)
    // - createdBy: string (manager uid)
    // - updatedBy: string (manager uid)
    // - createdAt: Timestamp
    // - updatedAt: Timestamp
    // =========================================================================
    match /roadblocks/{roadblockId} {
      // Anyone authenticated can read roadblocks
      allow read: if isAuthenticated();
      
      // Writes go through validated, audited manager callables only.
      allow write: if false;
    }
  }
}
