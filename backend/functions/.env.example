# Firebase Functions Environment Variables Example
# Copy this file to .env and fill in your values

# Region for Cloud Functions deployment
REGION=europe-west1

# Environment (development | staging | production)
ENVIRONMENT=development

# Logging level (debug | info | warn | error)
LOG_LEVEL=debug

# Maximum search radius for drivers (in meters)
MAX_SEARCH_RADIUS_METERS=5000

# Timeout for trip requests (in seconds)
TRIP_REQUEST_TIMEOUT_SECONDS=120

# Mapbox API Access Token
# Get your token from https://account.mapbox.com/access-tokens/
# For development/testing, you can use a free Mapbox public token
# Leave as placeholder to use mock Haversine distance calculation
MAPBOX_ACCESS_TOKEN=your-mapbox-token-here

# ============================================================================
# ONLINE PAYMENTS (Lahza)  -  DEFAULT OFF. See docs/LAHZA_SETUP.md
# ============================================================================
# Leave ONLINE_PAYMENTS_ENABLED unset/false and none of the rest is read.
# Only the literal string "true" enables it.
ONLINE_PAYMENTS_ENABLED=false

# Which adapter to use: "lahza" (default) or "stub".
# "stub" is refused unless running under the emulator - it marks trips paid
# without taking any money.
PAYMENT_PROVIDER=lahza

# Lahza SECRET key. Signs API calls AND verifies webhook signatures.
# NEVER commit a real key. Use a TEST key for development; in production this
# belongs in Secret Manager / Functions config, not in a .env file.
# Get it from the Lahza dashboard -> Settings -> API Keys.
LAHZA_SECRET_KEY=

# Lahza PUBLIC key. Not used by the backend today - listed because the mobile
# checkout step will need it. Safe to expose to clients.
LAHZA_PUBLIC_KEY=

# Optional. Overrides the API base URL (https://api.lahza.io). For testing only.
# LAHZA_BASE_URL=
