{
  "name": "taxi-line-platform",
  "version": "0.0.1",
  "private": true,
  "description": "Smart taxi line system for West Bank cities",
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx --cache",
    "lint:fix": "eslint . --ext .ts,.tsx --cache --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "corepack pnpm -r run typecheck",
    "firebase:node20": "node ./scripts/run-firebase-node20.cjs",
    "emulators:core": "corepack pnpm run build:functions && node ./scripts/run-firebase-node20.cjs emulators:start --only auth,firestore,functions,pubsub,storage",
    "emulators": "corepack pnpm run build:functions && node ./scripts/run-firebase-node20.cjs emulators:start",
    "emulators:persist": "corepack pnpm run build:functions && node ./scripts/run-firebase-node20.cjs emulators:start --import=./emulator-data --export-on-exit=./emulator-data",
    "build:shared": "corepack pnpm --filter @taxi-line/shared build",
    "build:functions": "corepack pnpm --filter @taxi-line/functions build",
    "qa:driver-eligibility:e2e": "corepack pnpm --filter @taxi-line/functions qa:driver-eligibility:e2e",
    "qa:request-lifecycle:e2e": "corepack pnpm --filter @taxi-line/functions qa:request-lifecycle:e2e",
    "qa:cash-payment:e2e": "corepack pnpm --filter @taxi-line/functions qa:cash-payment:e2e",
    "qa:security-regression:e2e": "corepack pnpm --filter @taxi-line/functions qa:security-regression:e2e",
    "qa:pii-scoping:e2e": "corepack pnpm --filter @taxi-line/functions qa:pii-scoping:e2e",
    "qa:scheduled:e2e": "corepack pnpm --filter @taxi-line/functions qa:scheduled:e2e",
    "qa:reconciliation": "corepack pnpm --filter @taxi-line/functions qa:reconciliation",
    "qa:seat-accounting:e2e": "corepack pnpm --filter @taxi-line/functions qa:seat-accounting:e2e",
    "qa:search-radius:e2e": "corepack pnpm --filter @taxi-line/functions qa:search-radius:e2e",
    "qa:line-queue:e2e": "corepack pnpm --filter @taxi-line/functions qa:line-queue:e2e",
    "qa:operations-core:e2e": "corepack pnpm --filter @taxi-line/functions qa:operations-core:e2e",
    "qa:route-runs:e2e": "corepack pnpm --filter @taxi-line/functions qa:route-runs:e2e",
    "qa:all": "node ./scripts/run-firebase-node20.cjs emulators:exec --project waselneh-prod-414e2 --only auth,firestore,functions,pubsub,storage \"node scripts/run-qa-suites.mjs\"",
    "qa:driver-eligibility:e2e:exec": "node ./scripts/run-firebase-node20.cjs emulators:exec --project waselneh-prod-414e2 --only auth,firestore,functions,pubsub,storage \"node backend/functions/scripts/qa-driver-eligibility-e2e.mjs\"",
    "qa:driver-onboarding:e2e": "corepack pnpm --filter @taxi-line/functions qa:driver-onboarding:e2e",
    "qa:manager-login:e2e": "corepack pnpm --filter @taxi-line/functions qa:manager-login:e2e",
    "qa:otp-auth:e2e": "corepack pnpm --filter @taxi-line/functions qa:otp-auth:e2e",
    "qa:online-payments:e2e": "corepack pnpm --filter @taxi-line/functions qa:online-payments:e2e",
    "backfill:driver-eligibility:dry-run": "corepack pnpm --filter @taxi-line/functions backfill:driver-eligibility -- --project waselneh-prod-414e2",
    "backfill:driver-eligibility:apply": "corepack pnpm --filter @taxi-line/functions backfill:driver-eligibility:apply -- --project waselneh-prod-414e2",
    "deploy:staging:rules": "node ./scripts/run-firebase-node20.cjs deploy --project waselneh-staging-ayed --only firestore:rules,storage",
    "deploy:staging:indexes": "node ./scripts/run-firebase-node20.cjs deploy --project waselneh-staging-ayed --only firestore:indexes",
    "prepare:staging:functions": "corepack pnpm build:shared && corepack pnpm build:functions && node ./scripts/prepare-functions-deploy.mjs",
    "deploy:staging:functions": "corepack pnpm prepare:staging:functions && node ./scripts/run-firebase-node20.cjs deploy --config firebase.staging.json --project waselneh-staging-ayed --only functions",
    "deploy:prod": "node ./scripts/confirm-production-deploy.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "qa:unit": "node scripts/run-unit-tests.mjs",
    "qa:verify": "corepack pnpm qa:unit && corepack pnpm qa:all",
    "qa:referrals:e2e": "corepack pnpm --filter @taxi-line/functions qa:referrals:e2e",
    "qa:cancellation-benefits:e2e": "corepack pnpm --filter @taxi-line/functions qa:cancellation-benefits:e2e",
    "qa:settlement-reconciliation:e2e": "corepack pnpm --filter @taxi-line/functions qa:settlement-reconciliation:e2e",
    "deploy:indexes": "node ./scripts/confirm-production-deploy.mjs indexes",
    "passenger:staging:start": "node ./scripts/run-expo-staging.mjs passenger start",
    "passenger:staging:android": "node ./scripts/run-expo-staging.mjs passenger android",
    "driver:staging:start": "node ./scripts/run-expo-staging.mjs driver start",
    "driver:staging:android": "node ./scripts/run-expo-staging.mjs driver android",
    "manager:staging:dev": "corepack pnpm --filter @waselneh/manager-web dev",
    "bootstrap:staging:admin:dry-run": "node ./scripts/bootstrap-staging-admin.mjs --project waselneh-staging-ayed --dry-run",
    "bootstrap:staging:admin": "node ./scripts/bootstrap-staging-admin.mjs --project waselneh-staging-ayed"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "dependencies": {
    "expo": "~54.0.33",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
