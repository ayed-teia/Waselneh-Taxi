# Driver App - REAL STAGING Firebase (waselneh-staging-ayed)
#
# Copy to .env.staging and fill in the Android app id from the Firebase Console.
# .env.staging is gitignored: it carries a real API key.
#
# Emulators and the dev auth bypass are OFF and must stay off. In pilot mode the
# connection guard refuses to start the app if either is requested.

EXPO_PUBLIC_APP_MODE=pilot
EXPO_PUBLIC_USE_EMULATORS=false
EXPO_PUBLIC_DEV_AUTH_BYPASS=false

# Real authentication UI. With this off, pilot has no way to sign in, because the
# dev login is (correctly) disabled outside dev+emulators.
EXPO_PUBLIC_ENABLE_PHONE_AUTH=true

EXPO_PUBLIC_FIREBASE_PROJECT_ID=waselneh-staging-ayed
EXPO_PUBLIC_FIREBASE_API_KEY=<staging web api key>
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=waselneh-staging-ayed.firebaseapp.com
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=waselneh-staging-ayed.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=825430075871
EXPO_PUBLIC_FIREBASE_ANDROID_APP_ID=1:825430075871:android:DRIVER_ANDROID_APP_ID

# Native package installed on the device by the staging dev-client build.
# app.config.js derives this from EXPO_PUBLIC_APP_MODE=pilot.
# Expected package: com.taxiline.driver.staging

EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=<mapbox token>
